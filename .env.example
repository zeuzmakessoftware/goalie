OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: override the default free model.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# You can also select this per command with --openrouter-model. Confirm current
# model slugs at https://openrouter.ai/models.

# Optional OpenRouter attribution metadata.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_TITLE=Goalie CLI

# Optional. Codex normally reuses the local `codex` CLI login. The API key is
# only needed when that installation is configured for API authentication.
# OPENAI_API_KEY=your_openai_api_key

# Optional. Claude normally reuses the local `claude` CLI login.
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional storage overrides. Defaults follow XDG directories.
# GOALIE_CONFIG_DIR=~/.config/goalie
# GOALIE_DATA_DIR=~/.local/share/goalie
