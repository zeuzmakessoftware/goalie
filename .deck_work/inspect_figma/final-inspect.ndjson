{"kind":"textbox","id":"sh/32l0j2dw","slide":3,"name":"core-insight","text":"“Agents need a coach,\nnot one perfect first try.”","textPreview":"“Agents need a coach, | not one perfect first try.”","textChars":49,"textLines":2,"bbox":[109.98,185.01,1059.97,179.98]}
