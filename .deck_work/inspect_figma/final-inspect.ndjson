{"kind":"textbox","id":"sh/7i147mxk","slide":8,"name":"why-now-title","text":"Failure is fuel for long-horizon agents.","textPreview":"Failure is fuel for long-horizon agents.","textChars":40,"textLines":1,"bbox":[63.99,135.99,779.98,67.96]}
{"kind":"textbox","id":"sh/6hsne1gz","slide":8,"text":"01","textPreview":"01","textChars":2,"textLines":1,"bbox":[63.99,270.01,79.97,29.97]}
{"kind":"textbox","id":"sh/qxkfqpsn","slide":8,"text":"Longer tasks","textPreview":"Longer tasks","textChars":12,"textLines":1,"bbox":[180.02,266,359.96,37.95]}
{"kind":"textbox","id":"sh/rytgzu98","slide":8,"text":"More coupled steps create more chances to drift.","textPreview":"More coupled steps create more chances to drift.","textChars":48,"textLines":1,"bbox":[569.99,270.01,589.95,53.97]}
{"kind":"shape","id":"sh/sz2xszad","slide":8,"name":"reason-rule-1","bbox":[63.99,348.02,1095.95,0.94]}
